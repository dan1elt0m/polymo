from pyspark import pipelines as dp  # noqa: E402
from pyspark.sql import SparkSession  # noqa: E402

spark = SparkSession.getActiveSession()

{% if schema_ddl %}
SCHEMA = {{ schema_ddl | tojson }}

{% endif %}

{% if streaming %}
from pyspark.sql.datasource import DataSource, SimpleDataSourceStreamReader  # noqa: E402

# Assumes SCHEMA is a comma-separated "name TYPE" DDL string (as emitted
# above); column names are taken as the first whitespace-separated token.
COLUMNS = [f.split()[0] for f in SCHEMA.split(",")]


class _Reader(SimpleDataSourceStreamReader):
    def initialOffset(self):
        return {"page": 0}

    def read(self, start):
        page = start["page"]
        records = fetch_page(page)
        rows = [tuple(r.get(c) for c in COLUMNS) for r in records]
        next_page = page + 1 if records else page
        return iter(rows), {"page": next_page}

    def readBetweenOffsets(self, start, end):
        rows = []
        for page in range(start["page"], end["page"]):
            for r in fetch_page(page):
                rows.append(tuple(r.get(c) for c in COLUMNS))
        return iter(rows)


class RestStreamSource(DataSource):
    @classmethod
    def name(cls):
        return "{{ func_name }}_stream"

    def schema(self):
        return SCHEMA

    def simpleStreamReader(self, schema):
        return _Reader()


spark.dataSource.register(RestStreamSource)


@dp.table(name={{ table_name_repr }})
def {{ func_name }}():
    return spark.readStream.format("{{ func_name }}_stream").load()
{% else %}
{% if has_windows %}
from pyspark.sql.datasource import DataSource, DataSourceReader, InputPartition  # noqa: E402
{% else %}
from pyspark.sql.datasource import DataSource, DataSourceReader  # noqa: E402
{% endif %}


class RestSource(DataSource):
    @classmethod
    def name(cls):
        return "{{ func_name }}_source"

    def schema(self):
        return {% if schema_ddl %}SCHEMA{% else %}_infer_schema(){% endif %}


    def reader(self, schema):
        return _Reader(schema)


class _Reader(DataSourceReader):
    def __init__(self, schema):
        self._columns = [field.name for field in schema.fields]

{% if has_windows %}
    def partitions(self):
        return [InputPartition(index) for index in range(len(WINDOWS))]

    def read(self, partition):
        records = fetch_records(**WINDOWS[partition.value])
{% else %}
    def read(self, partition):
        records = fetch_records()
{% endif %}
{% if incremental_mode %}
        cursor = None
{% endif %}
        for record in records:
{% if incremental_mode %}
            value = record.get({{ cursor_field_repr }})
            if value is not None and (cursor is None or value > cursor):
                cursor = value
{% endif %}
            yield tuple(_cell(record.get(column)) for column in self._columns)
{% if incremental_mode %}
        # read() runs per partition on the executor that owns it, so each
        # partition writes its own max cursor independently; whichever
        # partition finishes last wins. Batch tables re-fetch fully each
        # run, so a stale cursor only costs redundant fetching, not missed
        # data. STATE_PATH must point somewhere every executor can reach
        # (e.g. a Databricks Volume, per the comment on it above) for this
        # to work at all.
        _write_state(cursor)
{% endif %}


def _cell(value):
    """Nested structures become JSON strings; scalars pass through."""
    if isinstance(value, (dict, list)):
        import json

        return json.dumps(value)
    return value


spark.dataSource.register(RestSource)


