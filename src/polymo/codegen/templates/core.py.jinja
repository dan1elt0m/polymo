def _dig(payload: Any, path: list[str]) -> Any:
    """Follow a key path into a JSON payload; None if any hop is missing."""
    current = payload
    for key in path:
        if isinstance(current, dict) and key in current:
            current = current[key]
        else:
            return None
    return current


