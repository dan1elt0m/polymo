def _read_state() -> dict[str, Any]:
    if not os.path.exists(STATE_PATH):
        return {}
    with open(STATE_PATH) as fh:
        return json.load(fh)


def _write_state(cursor: Any) -> None:
    if cursor is None:
        return
    with open(STATE_PATH, "w") as fh:
        json.dump({"cursor": cursor}, fh)
