{% endif %}
{% for key_repr, value_repr in oauth_extra_items %}
        {{ key_repr }}: {{ value_repr }},
{% endfor %}
    }
    response = requests.post(TOKEN_URL, data=payload, timeout=TIMEOUT)
    response.raise_for_status()
    return response.json()["access_token"]
