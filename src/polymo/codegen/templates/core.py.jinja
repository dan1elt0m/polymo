def _request(session: requests.Session, url: str, params: dict[str, Any] | None) -> requests.Response:
{% if max_retries == 0 %}
    response = session.get(url, params=params, timeout=TIMEOUT)
    response.raise_for_status()
    return response
{% else %}
    delay = INITIAL_DELAY
    for attempt in range(MAX_RETRIES + 1):
{% if retry_on_timeout or retry_on_connection_errors %}
        try:
            response = session.get(url, params=params, timeout=TIMEOUT)
{% if retry_on_timeout %}
        except requests.exceptions.Timeout:
            if attempt == MAX_RETRIES:
                raise
{% endif %}
{% if retry_on_connection_errors %}
        except requests.exceptions.ConnectionError:
            if attempt == MAX_RETRIES:
                raise
{% endif %}
        else:
            if not _should_retry(response.status_code) or attempt == MAX_RETRIES:
                response.raise_for_status()
                return response
{% else %}
        response = session.get(url, params=params, timeout=TIMEOUT)
        if not _should_retry(response.status_code) or attempt == MAX_RETRIES:
            response.raise_for_status()
            return response
{% endif %}
        time.sleep(delay)
{% if max_delay > 0 %}
        delay = min(delay * BACKOFF, MAX_DELAY)
{% else %}
        delay *= BACKOFF
{% endif %}
    raise RuntimeError("unreachable")
{% endif %}


