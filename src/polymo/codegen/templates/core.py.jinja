def fetch_page(page_index: int) -> list[dict[str, Any]]:
    """Fetch one page by index; returns a list of records."""
    session = requests.Session()
    session.headers.update(HEADERS)
{% if auth_type == "oauth2" %}
    session.headers["Authorization"] = f"Bearer {get_token()}"
{% elif auth_type == "bearer" %}
    session.headers["Authorization"] = f"Bearer {API_TOKEN}"
{% elif auth_type == "api_key" and api_key_in == "header" %}
    session.headers[{{ api_key_name_repr }}] = API_KEY
{% endif %}
    params = dict(PARAMS)
{% if limit_param and page_size %}
    params[{{ limit_param_repr }}] = {{ page_size }}
{% endif %}
{% if pagination_type == "page" %}
    params[{{ page_param_repr }}] = {{ start_page }} + page_index
{% else %}
    params[{{ offset_param_repr }}] = {{ start_offset }} + page_index * {{ page_size }}
{% endif %}
{% if auth_type == "api_key" and api_key_in == "query" %}
    params[{{ api_key_name_repr }}] = API_KEY
{% endif %}
    response = _request(session, f"{BASE_URL}{PATH}", params)
    return _records({% if response_format == "xml" %}ET.fromstring(response.content){% else %}response.json(){% endif %})
