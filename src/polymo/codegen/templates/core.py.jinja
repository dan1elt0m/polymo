def get_token() -> str:
    """Fetch an OAuth2 access token (client credentials grant)."""
{% if client_secret_optional %}
{{ raise_not_installed("CLIENT_SECRET") }}
{% endif %}
    payload = {
        "grant_type": "client_credentials",
        "client_id": {{ client_id_repr }},
        "client_secret": CLIENT_SECRET,
{% if scope %}
        "scope": {{ scope_repr }},
{% endif %}
{% if audience %}
