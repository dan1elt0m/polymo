{% endif %}
{% if audience %}
        "audience": "{{ audience }}",
{% endif %}
{% for key, value_repr in oauth_extra_items %}
        "{{ key }}": {{ value_repr }},
{% endfor %}
    }
    response = requests.post(TOKEN_URL, data=payload, timeout=TIMEOUT)
    response.raise_for_status()
    return response.json()["access_token"]
