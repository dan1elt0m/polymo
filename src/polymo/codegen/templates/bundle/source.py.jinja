class _Reader(DataSourceReader):
    def __init__(self, schema: Any{% if bundle_secret_slots %}, options: Any{% endif %}) -> None:
        self._columns: list[str] = [field.name for field in schema.fields]
{% if bundle_secret_slots %}
        self._secret_options: dict[str, str] = {
            key: value
            for key, value in options.items()
            if key.lower().startswith("secret_")
        }
{% endif %}
{% if pushdown %}
        self._pushed: dict[str, str] = {}

    def pushFilters(self, filters: list[Filter]) -> Iterable[Filter]:
        self._pushed = {}
        unsupported: list[Filter] = []
        for filter_ in filters:
            if isinstance(filter_, EqualTo) and len(filter_.attribute) == 1:
                param = PUSHDOWN_PARAMS.get(filter_.attribute[0])
                if param is not None and filter_.value is not None:
                    self._pushed[param] = str(filter_.value)
                    continue
            unsupported.append(filter_)
        return unsupported
{% endif %}

{% if has_windows %}
    def partitions(self) -> list[InputPartition]:
        return [InputPartition(index) for index in range(len(WINDOWS))]

    def read(self, partition) -> Iterator[tuple]:
{% if bundle_secret_slots %}
        _apply_secret_options(self._secret_options)
{% endif %}
{% if pushdown and windows_kind == "path" %}
        records = fetch_records(extra_params=self._pushed, **WINDOWS[partition.value])
{% elif pushdown %}
        extra_params = {**WINDOWS[partition.value]["extra_params"], **self._pushed}
