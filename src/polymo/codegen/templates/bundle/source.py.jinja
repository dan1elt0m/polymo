def _apply_secret_options(options: Any) -> None:
    """Install driver-resolved secrets onto `{{ bundle_pkg }}.client`'s module
    globals (see `pipelines/{{ func_name }}.py`, which resolves them driver-side
    and threads them through as DataSource reader options — a bare
    module-level `_dbx_secret(...)`/`_uc_secret(...)` call in `client.py`
    would fail here: every Spark Python worker gets its own fresh
    `{{ bundle_pkg }}.client` import, with no SparkSession/dbutils available).
    Called from `schema()` and `reader()`/`simpleStreamReader()` below so
    both schema inference and the actual read see the real value, on
    whichever process (driver or worker) ends up running them. `options` is
    Spark's case-insensitive options mapping — keys always come back
    lowercased, so the slot name is reconstructed via `.upper()` (every
    slot this generator ever names — API_TOKEN/API_KEY/CLIENT_SECRET/OPT_*
    — is uppercase by construction).
    """
    prefix = "polymo_secret_"
    for key, value in options.items():
        if key.lower().startswith(prefix):
            setattr(_client, key[len(prefix) :].upper(), value)
{% if rebuild_option_globals %}
    # PATH/PARAMS/HEADERS above embed one of these OPT_* values inside an
    # f-string/dict literal that already evaluated at import time (with the
    # "REPLACE_ME" placeholder) — the setattr above never reaches it, so
    # rebuild those literals now that the real value is installed.
    _client._rebuild_option_literals()
{% endif %}

{% endif %}
