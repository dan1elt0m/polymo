class _Reader(DataSourceReader):
    def __init__(self, schema: Any{% if bundle_secret_slots %}, options: Any{% endif %}) -> None:
        self._columns: list[str] = [field.name for field in schema.fields]
{% if bundle_secret_slots %}
        self._secret_options: dict[str, str] = {
            key: value
            for key, value in options.items()
            if key.lower().startswith("secret_")
        }
{% endif %}

{% if has_windows %}
    def partitions(self) -> list[InputPartition]:
        return [InputPartition(index) for index in range(len(WINDOWS))]

    def read(self, partition) -> Iterator[tuple]:
{% if bundle_secret_slots %}
        _apply_secret_options(self._secret_options)
{% endif %}
        records = fetch_records(**WINDOWS[partition.value])
{% elif page_partitions and incremental %}
    def partitions(self) -> list[InputPartition]:
{% if bundle_secret_slots %}
        _apply_secret_options(self._secret_options)
{% endif %}
        state_cursor = _read_state()
        total = _probe_total_pages(state_cursor)
        if total is None or total <= 1:
            return [InputPartition((None, state_cursor))]
        return [InputPartition((index, state_cursor)) for index in range(total)]

    def read(self, partition) -> Iterator[tuple]:
{% if bundle_secret_slots %}
        _apply_secret_options(self._secret_options)
{% endif %}
        page_index, state_cursor = partition.value
        if page_index is None:
            records = fetch_records()
        else:
            records = fetch_page(page_index, state_cursor)
{% elif page_partitions %}
    def partitions(self) -> list[InputPartition]:
{% if bundle_secret_slots %}
        _apply_secret_options(self._secret_options)
{% endif %}
        total = _probe_total_pages()
        if total is None or total <= 1:
            return [InputPartition(None)]
        return [InputPartition(index) for index in range(total)]

    def read(self, partition) -> Iterator[tuple]:
{% if bundle_secret_slots %}
        _apply_secret_options(self._secret_options)
{% endif %}
        if partition.value is None:
            records = fetch_records()
        else:
            records = fetch_page(partition.value)
{% else %}
    def read(self, partition) -> Iterator[tuple]:
{% if bundle_secret_slots %}
        _apply_secret_options(self._secret_options)
{% endif %}
        records = fetch_records()
{% endif %}
{% if incremental %}
        cursor = None
{% endif %}
        for record in records:
{% if incremental %}
            value = _cursor_of(record)
            if value is not None and (cursor is None or value > cursor):
                cursor = value
{% endif %}
{% if schema_ddl %}
            yield tuple(record.get(column) for column in self._columns)
{% else %}
            yield tuple(_cell(record.get(column)) for column in self._columns)
{% endif %}
{% if incremental %}
        if cursor is not None:
            _write_state(cursor)
{% endif %}


{% if not schema_ddl %}
def _cell(value: Any) -> Any:
    if isinstance(value, (dict, list)):
        import json

        return json.dumps(value)
    return value
