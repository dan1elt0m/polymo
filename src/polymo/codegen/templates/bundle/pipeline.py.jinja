"""{{ stream_name_doc }} — Lakeflow Declarative Pipeline source (Databricks Asset Bundle).

Registers the `{{ source_class_name }}` data source from `{{ bundle_pkg }}.source`
(built on `{{ bundle_pkg }}.client`) and wires it to a `@dp.table`; edit this
file freely — it is not read by polymo again.
"""

from pyspark import pipelines as dp  # noqa: E402
from pyspark.sql import SparkSession  # noqa: E402
from {{ bundle_pkg }}.source import {{ source_class_name }}  # noqa: E402

# `databricks.yml` builds `src/{{ bundle_pkg }}` into a wheel and installs it via
# the pipeline's `environment.dependencies`, so `{{ bundle_pkg }}` is importable
# on the driver AND every executor — no by-value pickling needed.
spark = SparkSession.getActiveSession()
spark.dataSource.register({{ source_class_name }})


{% if streaming %}
@dp.table(name={{ table_name_repr }})
def {{ func_name }}():
    return spark.readStream.format("{{ func_name }}_stream").load()
{% else %}
{% if partition_strategy == "pagination" %}
# partition strategy "pagination" runs sequentially in generated scripts
{% endif %}
@dp.table(name={{ table_name_repr }})
def {{ func_name }}():
    return spark.read.format("{{ func_name }}_source").load()
{% endif %}
