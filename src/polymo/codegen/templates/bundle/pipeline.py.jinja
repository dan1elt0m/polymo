"""Lakeflow Declarative Pipeline for {{ stream_name_doc }}."""

from pyspark import pipelines as dp
from pyspark.sql import SparkSession
{% if bundle_secret_slots %}
from {{ bundle_pkg }} import client
{% endif %}
from {{ bundle_pkg }}.source import {{ source_class_name }}

spark = SparkSession.getActiveSession()
{% if pushdown %}
spark.conf.set("spark.sql.python.filterPushdown.enabled", "true")
{% endif %}
spark.dataSource.register({{ source_class_name }})
{% if bundle_secret_slots %}

_resolved_secrets = {
{% for var, call_expr in bundle_secret_slots %}
    {{ var | tojson }}: {{ call_expr }},
{% endfor %}
}
_secret_options = {f"secret_{key}": value for key, value in _resolved_secrets.items()}
{% endif %}


{% if streaming %}
@dp.table(name={{ table_name_repr }})
def {{ func_name }}():
    return spark.readStream.format("{{ func_name }}_stream"){% if bundle_secret_slots %}.options(**_secret_options){% endif %}.load()
{% else %}
@dp.table(name={{ table_name_repr }})
def {{ func_name }}():
    return spark.read.format("{{ func_name }}_source"){% if bundle_secret_slots %}.options(**_secret_options){% endif %}.load()
{% endif %}
