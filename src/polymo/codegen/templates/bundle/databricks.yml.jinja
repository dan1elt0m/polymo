# Databricks Asset Bundle for {{ project_name }}, generated by polymo.
# See https://docs.databricks.com/dev-tools/bundles/index.html for docs.
bundle:
  name: {{ bundle_name_repr }}

# `databricks bundle deploy` builds this wheel (via `uv build --wheel`,
# requires `uv` on the deploy machine — see pyproject.toml) and uploads it
# to the workspace; the pipeline's `environment.dependencies` below then
# installs it, so `src/{{ bundle_pkg }}` is importable on the driver AND every
# executor. Requires `serverless: true` on the pipeline resource — a
# classic-cluster pipeline would need the wheel added as a cluster library
# instead.
artifacts:
  default:
    type: whl
    build: uv build --wheel
    path: .

resources:
  pipelines:
    {{ pipeline_key }}:
      name: {{ pipeline_key_repr }}
      catalog: {{ catalog_repr }}
      schema: {{ schema_repr }}
      serverless: true
      # `root_path` is added to `sys.path` when Databricks runs this
      # pipeline's Python sources, which is what makes the `pipelines/{{ stream }}.py`
      # glob below resolve; `src/{{ bundle_pkg }}` itself is NOT under root_path — it
      # reaches the driver and every executor via the built wheel instead
      # (see `environment.dependencies` below), so `from {{ bundle_pkg }} import
      # client, source` in that file just works everywhere.
      root_path: src
      libraries:
        - glob:
            include: pipelines/{{ stream }}.py
      environment:
        dependencies:
          - ${workspace.root_path}/artifacts/.internal/*.whl

targets:
  dev:
    mode: development
    default: true
  prod:
    mode: production
